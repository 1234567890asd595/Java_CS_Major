import java.util.*;

public class LoopRandoms_UntilGet37 {

	public static void main(String[] args) {
	Random randNumGen = new Random();
	
	int randomNumber = randNumGen.nextInt(50) + 1;
	while (randomNumber != 37) {
		System.out.print(randomNumber + " ");
		randomNumber = randNumGen.nextInt(50) + 1;		
	}
	
	}

}
